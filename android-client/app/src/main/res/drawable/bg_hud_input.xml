<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:state_focused="true">
        <drawable
            class="com.hubpc.client.ui.HudShapeDrawable"
            app:hudFill="@color/panel"
            app:hudStroke="@color/cyan_glow"
            app:hudStrokeWidth="1dp" />
    </item>
    <item>
        <drawable
            class="com.hubpc.client.ui.HudShapeDrawable"
            app:hudFill="@color/panel"
            app:hudStroke="@color/border"
            app:hudStrokeWidth="1dp" />
    </item>
</selector>

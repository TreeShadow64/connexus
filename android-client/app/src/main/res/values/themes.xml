<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HubClient" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorPrimaryDark">@color/bg_deep</item>
        <item name="colorAccent">@color/cyan</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="buttonStyle">@style/Widget.Hud.Button</item>
        <item name="materialButtonStyle">@style/Widget.Hud.Button</item>
    </style>

    <style name="NumButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">2dp</item>
    </style>

    <style name="Widget.Hud.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/line_strong</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">monospace</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Hud.Button.Accent">
        <item name="backgroundTint">@color/cyan</item>
        <item name="android:textColor">@color/bg_deep</item>
    </style>

    <style name="Text.Hud.Eyebrow" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Hud.SectionLabel" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/cyan</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Hud.Status" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="HelpBadge">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:background">@drawable/bg_help_badge</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_faint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ModuleCard">
        <item name="android:background">@drawable/bg_module_card</item>
        <item name="android:padding">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Text.Hud.Caption" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">@color/remote_caption_text</item>
        <item name="android:textSize">7sp</item>
    </style>

    <style name="RemoteKey">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/remote_btn_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="RemoteKey.Circle">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_remote_circle</item>
    </style>

    <style name="RemoteKey.Pill">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/bg_remote_pill</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="IMPOSTAZIONI"
            android:textColor="@color/cyan"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- account -->
        <TextView
            style="@style/Text.Hud.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="account" />

        <LinearLayout
            style="@style/ModuleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="false"
            android:focusable="false">

            <TextView
                android:id="@+id/textAccountEmail"
                style="@style/Text.Hud.Status"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="accesso non configurato" />

            <TextView
                android:id="@+id/buttonSignOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:text="ESCI"
                android:textColor="@color/red"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- aspetto -->
        <TextView
            style="@style/Text.Hud.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="aspetto" />

        <LinearLayout
            style="@style/ModuleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="false"
            android:focusable="false">

            <TextView
                style="@style/Text.Hud.SectionLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:text="Tema" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_toggle_track"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/toggleThemeDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="SCURO"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/toggleThemeLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="CHIARO"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- connessione -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp">

            <TextView
                style="@style/Text.Hud.Eyebrow"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="connessioni al pc" />

            <TextView
                android:id="@+id/helpConnection"
                style="@style/HelpBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="?" />
        </LinearLayout>

        <TextView
            style="@style/Text.Hud.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAllCaps="false"
            android:text="La prima e' quella provata per prima; se non risponde si passa alla successiva." />

        <LinearLayout
            android:id="@+id/profilesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/buttonAddProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="+ AGGIUNGI CONNESSIONE" />

        <!-- assistenza -->
        <TextView
            style="@style/Text.Hud.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="assistenza" />

        <Button
            android:id="@+id/buttonFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="INVIA FEEDBACK O SEGNALAZIONE" />

        <!-- info -->
        <TextView
            style="@style/Text.Hud.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="info" />

        <TextView
            android:id="@+id/textAppVersion"
            style="@style/Text.Hud.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="versione" />

        <Button
            android:id="@+id/buttonUpdateApp"
            style="@style/Widget.Hud.Button.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="AGGIORNA APP" />

        <TextView
            android:id="@+id/textUpdateStatus"
            style="@style/Text.Hud.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/buttonResetData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/red"
            android:text="CANCELLA DATI SALVATI" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Account, connessioni al PC, assistenza e versione (sotto-schermata di Impostazioni) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hubpc.client.ui.HudTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudMode="sub"
        app:hudSubtitle="ACCOUNT // CONNESSIONI"
        app:hudTitle="Account e connessioni" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- account -->
            <LinearLayout
                style="@style/HudPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="account" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textAccountEmail"
                        style="@style/Text.Hud.Value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="accesso non configurato" />

                    <Button
                        android:id="@+id/buttonSignOut"
                        style="@style/Widget.Hud.Button.Danger"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESCI" />
                </LinearLayout>
            </LinearLayout>

            <!-- connessioni -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="connessioni al pc" />

                <TextView
                    android:id="@+id/helpConnection"
                    style="@style/HelpBadge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="?" />
            </LinearLayout>

            <TextView
                style="@style/Text.Hud.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="la prima e' quella provata per prima; se non risponde si passa alla successiva" />

            <LinearLayout
                android:id="@+id/profilesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/buttonAddProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ AGGIUNGI CONNESSIONE" />

            <Button
                android:id="@+id/buttonScanQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="SCANSIONA QR DAL PC" />

            <!-- assistenza -->
            <LinearLayout
                style="@style/HudPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="assistenza" />

                <Button
                    android:id="@+id/buttonFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="INVIA FEEDBACK O SEGNALAZIONE" />
            </LinearLayout>

            <Button
                android:id="@+id/buttonResetData"
                style="@style/Widget.Hud.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="CANCELLA DATI SALVATI" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Trova dispositivo: stessa sezione della dashboard PC (righe .hud-row) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hubpc.client.ui.HudTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudHelp="true"
        app:hudMode="section"
        app:hudSubtitle="DISPOSITIVI SUL TUO ACCOUNT"
        app:hudTitle="Trova Dispositivo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- suono dell'allarme di questo telefono -->
            <LinearLayout
                style="@style/HudPanelRaised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="suono allarme di questo telefono" />

                    <TextView
                        android:id="@+id/textAlarmSoundName"
                        style="@style/Text.Hud.Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="predefinito di sistema" />
                </LinearLayout>

                <Button
                    android:id="@+id/buttonChooseAlarmSound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="SCEGLI SUONO" />
            </LinearLayout>

            <TextView
                style="@style/Text.Hud.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="18dp"
                android:text="dispositivi sul tuo account" />

            <LinearLayout
                android:id="@+id/layoutDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/textFindStatus"
                style="@style/Text.Hud.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="[ log ]"
                android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>

    <com.hubpc.client.ui.HudNavBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudActive="find" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- TV: stessa sezione "TV" della dashboard PC (Telecomando + Condividi con la TV) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hubpc.client.ui.HudTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudHelp="true"
        app:hudMode="section"
        app:hudSubtitle="TELECOMANDO"
        app:hudTitle="TV" />

    <!-- .hud-subnav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:id="@+id/tabRemote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabRemoteLabel"
                style="@style/Text.Hud.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="9dp"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:text="Telecomando"
                android:textAllCaps="false"
                android:textColor="@color/cyan_glow"
                android:textSize="13sp" />

            <View
                android:id="@+id/tabRemoteLine"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/cyan_glow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSmartShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabSmartShareLabel"
                style="@style/Text.Hud.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="9dp"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:text="Condividi con la TV"
                android:textAllCaps="false"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <View
                android:id="@+id/tabSmartShareLine"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_soft" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ============ TELECOMANDO ============ -->
            <LinearLayout
                android:id="@+id/pageRemote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/HudPanelRaised"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textPairStatus"
                        style="@style/Text.Hud.Status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="TV non abbinata" />

                    <Button
                        android:id="@+id/buttonTvPair"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ABBINA TV" />
                </LinearLayout>

            <LinearLayout
                style="@style/HudPanelRaised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="alimentazione &amp; volume" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/buttonPower" style="@style/Widget.Hud.Button.Danger"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="POWER" />
                    <Button
                        android:id="@+id/buttonMute"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="MUTE" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/buttonVolDown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="VOL −" />
                    <Button
                        android:id="@+id/buttonVolUp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="VOL +" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/buttonChDown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="CH −" />
                    <Button
                        android:id="@+id/buttonChUp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="CH +" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                style="@style/HudPanelRaised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="direzionale" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1" />
                    <Button
                        android:id="@+id/buttonDpadUp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="▲" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/buttonDpadLeft"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="◀" />
                    <Button
                        android:id="@+id/buttonDpadEnter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="OK" />
                    <Button
                        android:id="@+id/buttonDpadRight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="▶" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1" />
                    <Button
                        android:id="@+id/buttonDpadDown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="▼" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/buttonHome"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="HOME" />
                    <Button
                        android:id="@+id/buttonDpadBack"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="INDIETRO" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                style="@style/HudPanelRaised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="tastierino" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/buttonNum1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="1" />
                    <Button
                        android:id="@+id/buttonNum2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="2" />
                    <Button
                        android:id="@+id/buttonNum3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="3" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/buttonNum4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="4" />
                    <Button
                        android:id="@+id/buttonNum5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="5" />
                    <Button
                        android:id="@+id/buttonNum6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="6" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/buttonNum7"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="7" />
                    <Button
                        android:id="@+id/buttonNum8"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="8" />
                    <Button
                        android:id="@+id/buttonNum9"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="9" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/buttonTvList"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="LIST" />
                    <Button
                        android:id="@+id/buttonNum0"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="0" />
                    <Button
                        android:id="@+id/buttonTvDash"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="—" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                style="@style/HudPanelRaised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="tasti colorati" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <View
                        android:id="@+id/buttonTvRed"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_capsule_red"
                        android:clickable="true"
                        android:focusable="true" />
                    <View
                        android:id="@+id/buttonTvGreen"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_capsule_green"
                        android:clickable="true"
                        android:focusable="true" />
                    <View
                        android:id="@+id/buttonTvYellow"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_capsule_yellow"
                        android:clickable="true"
                        android:focusable="true" />
                    <View
                        android:id="@+id/buttonTvBlue"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_capsule_blue"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                style="@style/HudPanelRaised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="extra" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/buttonSettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="MENU" />
                    <Button
                        android:id="@+id/buttonGuide"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="GUIDE" />
                    <Button
                        android:id="@+id/buttonInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="INFO" />
                    <Button
                        android:id="@+id/buttonExit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="EXIT" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/buttonPlay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="▶ PLAY" />
                    <Button
                        android:id="@+id/buttonPause"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="❚❚ PAUSA" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                style="@style/HudPanelRaised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="scorciatoie app" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/buttonQuickNetflix"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="NETFLIX" />
                    <Button
                        android:id="@+id/buttonQuickPrime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="PRIME VIDEO" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                style="@style/HudPanelRaised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="app installate" />

                <Button
                    android:id="@+id/buttonTvRefreshApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="AGGIORNA APP" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutTvApps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
            <LinearLayout
                style="@style/HudPanelRaised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="sorgenti" />

                <Button
                    android:id="@+id/buttonInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SORGENTI" />
            </LinearLayout>
            </LinearLayout>

            <!-- ============ CONDIVIDI CON LA TV ============ -->
            <LinearLayout
                android:id="@+id/pageSmartShare"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <LinearLayout
                style="@style/HudPanelRaised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textCastStatus"
                    style="@style/Text.Hud.Status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Google Cast: non connesso" />

                <androidx.mediarouter.app.MediaRouteButton
                    android:id="@+id/mediaRouteButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                style="@style/HudPanelRaised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="tv dlna in rete" />

                <Button
                    android:id="@+id/buttonCastDiscover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CERCA TV IN RETE" />

                <LinearLayout
                    android:id="@+id/layoutRenderers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout
                style="@style/HudPanelRaised"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="contenuto da riprodurre" />

                <Button
                    android:id="@+id/buttonCastPickFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SCEGLI DA GALLERIA" />

                <EditText
                    android:id="@+id/editCastFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="oppure nome file in media/ sul PC"
                    android:inputType="text"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/buttonCastPlay" style="@style/Widget.Hud.Button.Accent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="▶ AVVIA" />
                    <Button
                        android:id="@+id/buttonCastPause"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="❚❚ PAUSA" />
                    <Button
                        android:id="@+id/buttonCastStop" style="@style/Widget.Hud.Button.Danger"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:layout_weight="1"
                        android:text="■ STOP" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textStatus"
                style="@style/Text.Hud.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="[ log ]" />
        </LinearLayout>
    </ScrollView>

    <com.hubpc.client.ui.HudNavBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudActive="tv" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Overview: stessa schermata della dashboard PC, adattata al telefono -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hubpc.client.ui.HudTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudHelp="true"
        app:hudMode="home"
        app:hudSubtitle="HOST // ---" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:paddingEnd="11dp"
            android:paddingStart="11dp"
            android:paddingTop="22dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp">

                <FrameLayout
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center_horizontal">

                    <com.hubpc.client.ui.HudRingView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/clockLabel"
                            style="@style/Text.Hud.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:shadowColor="#6FE3FF"
                            android:shadowRadius="12"
                            android:text="--:--:--"
                            android:textColor="@color/hud_white"
                            android:textSize="29sp" />

                        <TextView
                            android:id="@+id/dateLabel"
                            style="@style/Text.Hud.Eyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="---" />

                        <TextView
                            android:id="@+id/clientsLabel"
                            style="@style/Text.Hud.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="NESSUN PC CONNESSO"
                            android:textSize="9sp" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                style="@style/HudPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginEnd="5dp"
                android:layout_marginStart="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="stato pc" />

                    <TextView
                        android:id="@+id/textPcAddress"
                        style="@style/Text.Hud.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="" />
                </LinearLayout>

                <Button
                    android:id="@+id/buttonConnect"
                    style="@style/Widget.Hud.Button.Accent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RICONNETTI" />
            </LinearLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2">

            <LinearLayout
                android:id="@+id/cardPcControl"
                style="@style/ModuleCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:minHeight="92dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="controllo remoto"
                        android:textSize="8sp" />

                    <View
                        android:id="@+id/dotPcControl"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_dot_idle" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/border_soft" />

                <TextView
                    style="@style/Text.Hud.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mouse / Tastiera" />

                <TextView
                    android:id="@+id/valuePcControl"
                    style="@style/Text.Hud.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="touchpad e tasti" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/cardScreen"
                style="@style/ModuleCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:minHeight="92dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="condivisione schermo"
                        android:textSize="8sp" />

                    <View
                        android:id="@+id/dotScreen"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_dot_idle" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/border_soft" />

                <TextView
                    style="@style/Text.Hud.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Schermo PC" />

                <TextView
                    android:id="@+id/valueScreen"
                    style="@style/Text.Hud.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="guarda il monitor" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/cardProjector"
                style="@style/ModuleCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:minHeight="92dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="specchio dal telefono"
                        android:textSize="8sp" />

                    <View
                        android:id="@+id/dotProjector"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_dot_idle" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/border_soft" />

                <TextView
                    style="@style/Text.Hud.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Projector" />

                <TextView
                    android:id="@+id/valueProjector"
                    style="@style/Text.Hud.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="telefono sul pc" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/cardVirtualCamera"
                style="@style/ModuleCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:minHeight="92dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="webcam verso pc"
                        android:textSize="8sp" />

                    <View
                        android:id="@+id/dotVirtualCamera"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_dot_idle" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/border_soft" />

                <TextView
                    style="@style/Text.Hud.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Virtual Camera" />

                <TextView
                    android:id="@+id/valueVirtualCamera"
                    style="@style/Text.Hud.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="telefono come webcam" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/cardUvcCamera"
                style="@style/ModuleCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:minHeight="92dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="webcam verso telefono"
                        android:textSize="8sp" />

                    <View
                        android:id="@+id/dotUvcCamera"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_dot_idle" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/border_soft" />

                <TextView
                    style="@style/Text.Hud.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Camera UVC" />

                <TextView
                    android:id="@+id/valueUvcCamera"
                    style="@style/Text.Hud.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="webcam del pc" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/cardTaskManager"
                style="@style/ModuleCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:minHeight="92dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="processi del pc"
                        android:textSize="8sp" />

                    <View
                        android:id="@+id/dotTaskManager"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_dot_idle" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/border_soft" />

                <TextView
                    style="@style/Text.Hud.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Manager" />

                <TextView
                    android:id="@+id/valueTaskManager"
                    style="@style/Text.Hud.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="elenco e chiusura" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/cardSystem"
                style="@style/ModuleCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:minHeight="92dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="sblocco uac da remoto"
                        android:textSize="8sp" />

                    <View
                        android:id="@+id/dotSystem"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_dot_idle" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/border_soft" />

                <TextView
                    style="@style/Text.Hud.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Servizio elevato" />

                <TextView
                    android:id="@+id/textSystemStatus"
                    style="@style/Text.Hud.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="verifica in corso" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/cardWake"
                style="@style/ModuleCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:orientation="vertical"
                android:minHeight="92dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="accensione remota"
                        android:textSize="8sp" />

                    <View
                        android:id="@+id/dotWake"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_dot_idle" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/border_soft" />

                <TextView
                    style="@style/Text.Hud.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wake-on-LAN" />

                <TextView
                    android:id="@+id/valueWake"
                    style="@style/Text.Hud.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="sveglia il pc" />
            </LinearLayout>
            </GridLayout>

            <TextView
                android:id="@+id/textStatus"
                style="@style/Text.Hud.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="14dp"
                android:text="[ log ]" />
        </LinearLayout>
    </ScrollView>

    <com.hubpc.client.ui.HudNavBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudActive="overview" />
</LinearLayout>

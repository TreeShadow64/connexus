<?xml version="1.0" encoding="utf-8"?>
<!-- Impostazioni: stessa sezione "Impostazioni" della dashboard PC (pannelli HUD) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hubpc.client.ui.HudTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudHelp="true"
        app:hudMode="section"
        app:hudSubtitle="SISTEMA // CONNESSIONI"
        app:hudTitle="Impostazioni" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- connessioni -->
            <LinearLayout
                style="@style/HudPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="connessioni al pc" />

                <TextView
                    style="@style/Text.Hud.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="indirizzi e token del PC, anche per usare l'app fuori casa" />

                <Button
                    android:id="@+id/buttonConnections"
                    style="@style/Widget.Hud.Button.Accent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="GESTISCI CONNESSIONI" />
            </LinearLayout>

            <!-- wake-on-lan -->
            <LinearLayout
                style="@style/HudPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="wake-on-lan" />

                <TextView
                    style="@style/Text.Hud.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="funziona solo sulla stessa rete Wi-Fi del PC" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/editMac"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:hint="indirizzo MAC del PC"
                        android:inputType="text"
                        android:maxLines="1" />

                    <Button
                        android:id="@+id/buttonGetMac"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OTTIENI" />
                </LinearLayout>

                <Button
                    android:id="@+id/buttonWakeOnLan"
                    style="@style/Widget.Hud.Button.Accent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="SVEGLIA PC" />
            </LinearLayout>

            <!-- servizio elevato -->
            <LinearLayout
                style="@style/HudPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="servizio con permessi elevati" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textServiceStatus"
                        style="@style/Text.Hud.Value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="servizio UAC: sconosciuto" />

                    <Button
                        android:id="@+id/buttonCheckService"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VERIFICA" />
                </LinearLayout>
            </LinearLayout>

            <!-- vpn integrata -->
            <LinearLayout
                style="@style/HudPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="vpn su questo telefono" />

                <TextView
                    android:id="@+id/textVpnStatus"
                    style="@style/Text.Hud.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="VPN spenta" />

                <TextView
                    android:id="@+id/textVpnDetail"
                    style="@style/Text.Hud.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAllCaps="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonVpnToggle"
                        style="@style/Widget.Hud.Button.Accent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="CONNETTI" />

                    <Button
                        android:id="@+id/buttonVpnChoose"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="SCEGLI SERVER" />
                </LinearLayout>

                <Button
                    android:id="@+id/buttonVpnImport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="IMPORTA CONFIGURAZIONI" />
            </LinearLayout>

            <!-- parsec e protonvpn sul pc -->
            <LinearLayout
                style="@style/HudPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="programmi sul pc" />

                <TextView
                    android:id="@+id/textAppsStatus"
                    style="@style/Text.Hud.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="PC non collegato" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonLaunchParsec"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="AVVIA PARSEC" />

                    <Button
                        android:id="@+id/buttonLaunchPcVpn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="VPN SUL PC" />
                </LinearLayout>

                <Button
                    android:id="@+id/buttonSetupApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="IMPOSTA PARSEC / VPN" />
            </LinearLayout>

            <!-- versione e aggiornamenti -->
            <LinearLayout
                style="@style/HudPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="aggiornamenti · github releases" />

                <TextView
                    style="@style/Text.Hud.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Versione app" />

                <TextView
                    android:id="@+id/textAppVersion"
                    style="@style/Text.Hud.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="versione" />

                <Button
                    android:id="@+id/buttonUpdateApp"
                    style="@style/Widget.Hud.Button.Accent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="CONTROLLA AGGIORNAMENTI" />

                <TextView
                    android:id="@+id/textUpdateStatus"
                    style="@style/Text.Hud.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAllCaps="false" />
            </LinearLayout>

            <!-- accesso da fuori casa -->
            <LinearLayout
                style="@style/HudPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="accesso da fuori casa" />

                <TextView
                    android:id="@+id/helpRemoteAccess"
                    style="@style/HelpBadge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="?" />
            </LinearLayout>

            <TextView
                android:id="@+id/textStatus"
                style="@style/Text.Hud.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="[ log ]" />
        </LinearLayout>
    </ScrollView>

    <com.hubpc.client.ui.HudNavBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudActive="settings" />
</LinearLayout>

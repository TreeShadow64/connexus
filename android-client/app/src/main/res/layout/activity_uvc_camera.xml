<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hubpc.client.ui.HudTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudHelp="true"
        app:hudMode="sub"
        app:hudSubtitle="WEBCAM DEL PC SUL TELEFONO"
        app:hudTitle="Camera UVC" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_hud_panel"
        android:padding="3dp">

        <ImageView
            android:id="@+id/imageUvc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Webcam del PC"
            android:scaleType="matrix" />

        <TextView
            android:id="@+id/textUvcStatus"
            style="@style/Text.Hud.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="[ ferma ]" />
    </FrameLayout>

    <LinearLayout
        style="@style/HudPanelRaised"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            style="@style/Text.Hud.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="dispositivo" />

        <LinearLayout
            android:id="@+id/layoutUvcDevices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />

        <Button
            android:id="@+id/buttonUvcToggle"
            style="@style/Widget.Hud.Button.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AVVIA" />

        <TextView
            style="@style/Text.Hud.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="luminosita'" />

        <SeekBar
            android:id="@+id/seekUvcBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            style="@style/Text.Hud.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="contrasto" />

        <SeekBar
            android:id="@+id/seekUvcContrast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />
    </LinearLayout>
</LinearLayout>

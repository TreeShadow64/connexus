<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hubpc.client.ui.HudTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudHelp="true"
        app:hudMode="sub"
        app:hudSubtitle="CONTROLLO REMOTO // TOUCHPAD E TASTI"
        app:hudTitle="Mouse / Tastiera" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- barra rapida: alimentazione + tastiera (.fz-quickbar) -->
        <LinearLayout
            style="@style/HudPanelRaised"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:paddingTop="8dp">

            <TextView
                style="@style/Text.Hud.Eyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="strumenti" />

            <ImageView
                android:id="@+id/buttonOpenPower"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:contentDescription="Alimentazione"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_power"
                app:tint="@color/cyan_glow" />

            <ImageView
                android:id="@+id/buttonOpenKeyboard"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:contentDescription="Tastiera"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_keyboard"
                app:tint="@color/cyan_glow" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <View
                android:id="@+id/touchpad"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_panel" />

            <TextView
                android:id="@+id/scrollWheel"
                style="@style/Text.Hud.Value"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_scroll_rail"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⇕"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonClickLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="CLIC SX" />

            <Button
                android:id="@+id/buttonClickMiddle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="CENTRALE" />

            <Button
                android:id="@+id/buttonClickRight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="CLIC DX" />
        </LinearLayout>

        <LinearLayout
            style="@style/HudPanelRaised"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textMouseLockStatus"
                style="@style/Text.Hud.Status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="mouse: libero tra gli schermi" />

            <Button
                android:id="@+id/buttonMouseLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BLOCCA" />
        </LinearLayout>

        <TextView
            android:id="@+id/textStatus"
            style="@style/Text.Hud.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="[ log ]" />
    </LinearLayout>
</LinearLayout>

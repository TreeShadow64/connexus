<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">

        <TextView
            style="@style/Text.Hud.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="benvenuto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="CONNEXUS"
            android:textColor="@color/cyan"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Text.Hud.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:textAllCaps="false"
            android:lineSpacingExtra="3dp"
            android:text="Prima di iniziare, collega l'app al PC: ti servono l'indirizzo IP e il token mostrati all'avvio del server sul PC. Potrai modificarli in qualsiasi momento dalle impostazioni." />

        <LinearLayout
            style="@style/ModuleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="false"
            android:focusable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="connessione al pc" />

                <TextView
                    android:id="@+id/helpConnection"
                    style="@style/HelpBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="?" />
            </LinearLayout>

            <EditText
                android:id="@+id/editIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:hint="IP del PC (es. 10.20.30.1)"
                android:textColorHint="@color/text_faint"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:breakStrategy="simple"
                android:importantForAutofill="no"
                android:inputType="text" />

            <EditText
                android:id="@+id/editToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="token (mostrato all'avvio del server)"
                android:textColorHint="@color/text_faint"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:maxLines="2"
                android:importantForAutofill="no"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonStart"
            style="@style/Widget.Hud.Button.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="INIZIA" />

        <TextView
            android:id="@+id/textOnboardingStatus"
            style="@style/Text.Hud.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

    </LinearLayout>
</ScrollView>

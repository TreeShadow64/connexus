<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp">

            <com.hubpc.client.ui.HudRingView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="Connexus"
                android:src="@drawable/ic_hud_logo" />
        </FrameLayout>

        <TextView
            style="@style/Text.Hud.Eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="benvenuto" />

        <TextView
            style="@style/Text.Hud.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="CONNEXUS // PHONE"
            android:textSize="22sp" />

        <TextView
            style="@style/Text.Hud.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Prima di iniziare, collega l'app al PC: ti servono l'indirizzo IP e il token mostrati all'avvio del server sul PC. Potrai modificarli in qualsiasi momento dalle impostazioni."
            android:textAllCaps="false" />

        <LinearLayout
            style="@style/HudPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="connessione al pc" />

                <TextView
                    android:id="@+id/helpConnection"
                    style="@style/HelpBadge"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="?" />
            </LinearLayout>

            <EditText
                android:id="@+id/editIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="IP del PC (es. 192.168.1.20)"
                android:importantForAutofill="no"
                android:inputType="text" />

            <EditText
                android:id="@+id/editToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="token (mostrato all'avvio del server)"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLines="2" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonScanQr"
            style="@style/Widget.Hud.Button.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="SCANSIONA IL CODICE QR DAL PC" />

        <TextView
            style="@style/Text.Hud.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="sul PC: dashboard → Impostazioni → Collega un telefono → MOSTRA QR"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/buttonStart"
            style="@style/Widget.Hud.Button.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="INIZIA" />

        <TextView
            android:id="@+id/textOnboardingStatus"
            style="@style/Text.Hud.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">

        <TextView
            style="@style/Text.Hud.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="accedi" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="CONNEXUS"
            android:textColor="@color/cyan"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonGoogleSignIn"
            style="@style/Widget.Hud.Button.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACCEDI CON GOOGLE" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp">

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/line" />
            <TextView
                style="@style/Text.Hud.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="oppure con email" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/line" />
        </LinearLayout>

        <LinearLayout
            style="@style/ModuleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="false"
            android:focusable="false">

            <EditText
                android:id="@+id/editEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="email"
                android:textColorHint="@color/text_faint"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:breakStrategy="simple"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="password"
                android:textColorHint="@color/text_faint"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:breakStrategy="simple"
                android:inputType="textPassword" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonLogin"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="ACCEDI" />

                <Button
                    android:id="@+id/buttonRegister"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="REGISTRATI" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textLoginStatus"
            style="@style/Text.Hud.Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>

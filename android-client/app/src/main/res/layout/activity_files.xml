<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textPageTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:text="GESTIONE FILE"
                    android:textColor="@color/cyan"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/helpFiles"
                    style="@style/HelpBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="?" />
            </LinearLayout>

            <!-- ============ PAGINA TRASFERIMENTO ============ -->
            <LinearLayout
                android:id="@+id/pageTransfer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="condivisione in rete" />

                <TextView
                    android:id="@+id/textShareStatus"
                    style="@style/Text.Hud.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:text="apre una pagina dedicata per esporre tutto lo storage via FTP" />

                <Button
                    android:id="@+id/buttonShareToggle"
                    style="@style/Widget.Hud.Button.Accent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="CONDIVIDI IN RETE (FTP)" />

                <LinearLayout
                    android:id="@+id/layoutSharedDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp" />

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="cartella locale" />

                <TextView
                    android:id="@+id/textCurrentPath"
                    style="@style/Text.Hud.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:text="nessuna cartella scelta" />

                <Button
                    android:id="@+id/buttonChooseFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="SCEGLI CARTELLA" />

                <LinearLayout
                    android:id="@+id/layoutFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ============ PAGINA PULIZIA ============ -->
            <LinearLayout
                android:id="@+id/pageCleaner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="156dp"
                    android:layout_height="156dp"
                    android:layout_marginTop="20dp"
                    android:layout_gravity="center_horizontal">

                    <com.hubpc.client.DonutChartView
                        android:id="@+id/donutStorage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/textStoragePercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:textSize="28sp"
                            android:text="—" />

                        <TextView
                            style="@style/Text.Hud.Eyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="occupato" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/textStorageUsage"
                    style="@style/Text.Hud.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="in scansione..." />

                <Button
                    android:id="@+id/buttonRescan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_gravity="center_horizontal"
                    android:text="AGGIORNA SCANSIONE" />

                <LinearLayout
                    style="@style/ModuleCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="false"
                    android:focusable="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Hud.Eyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="video" />

                        <TextView
                            android:id="@+id/textVideoSummary"
                            style="@style/Text.Hud.Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0 file" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/buttonDeleteVideos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/red"
                        android:text="ELIMINA" />
                </LinearLayout>

                <LinearLayout
                    style="@style/ModuleCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="false"
                    android:focusable="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Hud.Eyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="installer (apk)" />

                        <TextView
                            android:id="@+id/textApkSummary"
                            style="@style/Text.Hud.Status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0 file" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/buttonDeleteApks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/red"
                        android:text="ELIMINA" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="file di grandi dimensioni (oltre 50 MB)" />

                <LinearLayout
                    android:id="@+id/layoutLargeFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ============ PAGINA ESPLORA ============ -->
            <LinearLayout
                android:id="@+id/pageExplore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="memoria del telefono" />

                <TextView
                    android:id="@+id/textExplorePath"
                    style="@style/Text.Hud.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:text="/" />

                <LinearLayout
                    android:id="@+id/layoutExplore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/textStatus"
                style="@style/Text.Hud.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="[ log ]" />

        </LinearLayout>
    </ScrollView>

    <!-- selettore in basso stile TV Time, a icone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingTop="2dp">

        <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/line" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/tabTransfer"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/tabTransferIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Trasferimento"
                android:src="@drawable/ic_transfer"
                app:tint="@color/cyan" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabCleaner"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/tabCleanerIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Pulizia"
                android:src="@drawable/ic_clean"
                app:tint="@color/text_faint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabExplore"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/tabExploreIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Esplora"
                android:src="@drawable/ic_folder"
                app:tint="@color/text_faint" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

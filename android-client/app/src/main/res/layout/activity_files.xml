<?xml version="1.0" encoding="utf-8"?>
<!-- File & Rete: trasferimento (FTP + cartella condivisa), pulizia, esplora -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hubpc.client.ui.HudTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudHelp="true"
        app:hudMode="section"
        app:hudSubtitle="TRASFERIMENTO FILE"
        app:hudTitle="File &amp; Rete" />

    <!-- .hud-subnav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingEnd="10dp"
        android:paddingStart="10dp">

        <LinearLayout
            android:id="@+id/tabTransfer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabTransferLabel"
                style="@style/Text.Hud.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="9dp"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:text="Trasferimento"
                android:textAllCaps="false"
                android:textColor="@color/cyan_glow"
                android:textSize="13sp" />

            <View
                android:id="@+id/tabTransferLine"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/cyan_glow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabCleaner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabCleanerLabel"
                style="@style/Text.Hud.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="9dp"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:text="Pulizia"
                android:textAllCaps="false"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <View
                android:id="@+id/tabCleanerLine"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabExplore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabExploreLabel"
                style="@style/Text.Hud.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="9dp"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:text="Esplora"
                android:textAllCaps="false"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <View
                android:id="@+id/tabExploreLine"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_soft" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- ============ TRASFERIMENTO ============ -->
            <LinearLayout
                android:id="@+id/pageTransfer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- .fz-quickbar: condivisione FTP del telefono -->
                <LinearLayout
                    style="@style/HudPanelRaised"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="condivisione in rete" />

                    <TextView
                        android:id="@+id/textShareStatus"
                        style="@style/Text.Hud.Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="apre una pagina dedicata per esporre tutto lo storage via FTP"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/buttonShareToggle"
                        style="@style/Widget.Hud.Button.Accent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="CONDIVIDI IN RETE (FTP)" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="16dp"
                    android:text="condivisioni sul tuo account" />

                <LinearLayout
                    android:id="@+id/layoutSharedDevices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- .fz-pane: sito locale -->
                <LinearLayout
                    style="@style/HudPanelRaised"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="sito locale · cartella condivisa nell'app" />

                    <TextView
                        android:id="@+id/textCurrentPath"
                        style="@style/Text.Hud.Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:layout_marginTop="6dp"
                        android:text="nessuna cartella scelta" />

                    <Button
                        android:id="@+id/buttonChooseFolder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="SCEGLI CARTELLA" />

                    <LinearLayout
                        android:id="@+id/layoutFiles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ PULIZIA ============ -->
            <LinearLayout
                android:id="@+id/pageCleaner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    style="@style/HudPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="spazio occupato" />

                    <FrameLayout
                        android:layout_width="156dp"
                        android:layout_height="156dp"
                        android:layout_marginTop="14dp">

                        <com.hubpc.client.DonutChartView
                            android:id="@+id/donutStorage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textStoragePercent"
                                style="@style/Text.Hud.Mono"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:shadowColor="#6FE3FF"
                                android:shadowRadius="12"
                                android:text="—"
                                android:textColor="@color/hud_white"
                                android:textSize="28sp" />

                            <TextView
                                style="@style/Text.Hud.Eyebrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="occupato" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/textStorageUsage"
                        style="@style/Text.Hud.Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="in scansione..." />

                    <Button
                        android:id="@+id/buttonRescan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="AGGIORNA SCANSIONE" />
                </LinearLayout>

                <LinearLayout
                    style="@style/HudPanelRaised"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Hud.Eyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="video" />

                        <TextView
                            android:id="@+id/textVideoSummary"
                            style="@style/Text.Hud.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0 file" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/buttonDeleteVideos"
                        style="@style/Widget.Hud.Button.Danger"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ELIMINA" />
                </LinearLayout>

                <LinearLayout
                    style="@style/HudPanelRaised"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Hud.Eyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="installer (apk)" />

                        <TextView
                            android:id="@+id/textApkSummary"
                            style="@style/Text.Hud.Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0 file" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/buttonDeleteApks"
                        style="@style/Widget.Hud.Button.Danger"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ELIMINA" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Hud.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="file di grandi dimensioni (oltre 50 mb)" />

                <LinearLayout
                    android:id="@+id/layoutLargeFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ============ ESPLORA ============ -->
            <LinearLayout
                android:id="@+id/pageExplore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    style="@style/HudPanelRaised"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Hud.Eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="memoria del telefono" />

                    <TextView
                        android:id="@+id/textExplorePath"
                        style="@style/Text.Hud.Value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="6dp"
                        android:text="/" />

                    <LinearLayout
                        android:id="@+id/layoutExplore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textStatus"
                style="@style/Text.Hud.Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="[ log ]" />
        </LinearLayout>
    </ScrollView>

    <com.hubpc.client.ui.HudNavBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudActive="files" />
</LinearLayout>

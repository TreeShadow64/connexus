<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hubpc.client.ui.HudTopBar
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hudHelp="true"
        app:hudMode="sub"
        app:hudSubtitle="TUTTO LO STORAGE VIA FTP // MOMENTANEA"
        app:hudTitle="Condivisione FTP" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <FrameLayout
            android:layout_width="190dp"
            android:layout_height="190dp">

            <com.hubpc.client.ui.HudRingView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="Rete"
                android:src="@drawable/ic_wifi"
                app:tint="@color/cyan_glow" />
        </FrameLayout>

        <TextView
            android:id="@+id/textFtpStatus"
            style="@style/Text.Hud.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="condivisione disattivata"
            android:textSize="14sp" />

        <TextView
            style="@style/Text.Hud.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="indirizzo · tocca per copiare" />

        <TextView
            android:id="@+id/textFtpAddress"
            style="@style/Text.Hud.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_module_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:paddingTop="16dp"
            android:text="ftp://..."
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonFtpToggle"
                style="@style/Widget.Hud.Button.Accent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="AVVIA" />

            <Button
                android:id="@+id/buttonFtpAdvanced"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="IMPOSTAZIONI" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
